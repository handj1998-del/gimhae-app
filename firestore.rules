rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /pages/{pageId} {
      allow read: if true;
      // TODO: restrict to admin email, e.g.
      // allow write: if request.auth != null && request.auth.token.email == "admin@example.com";
      allow write: if request.auth != null;
    }
  }
}
